def make_iii_config(
    port: int,
    worker_port: int,
    quiet: bool = False,
    exec_module: bool = True,
    state_dir: str | None = None,
) -> str:
    """Create a temporary config.yaml with unique HTTP and Worker ports, return the path."""
    base_config = os.path.join(workflow_dir, "config.yaml")
    with open(base_config, "r") as f:
        content = f.read()
    # Replace top-level engine WebSocket port and WorkerModule port (both default 49134),
    # then RestApiModule HTTP port (default 3111).
    content = content.replace("port: 49134", f"port: {worker_port}")
    content = content.replace("port: 3111", f"port: {port}", 1)
    content = content.replace("host: 0.0.0.0", "host: 127.0.0.1")
    if state_dir is not None:
        content = content.replace(
            "file_path: ./data/state_store.db",
            f"file_path: {state_dir}",
        )
    if quiet:
        content = content.replace(
            "exporter: memory",
            "exporter: memory\n      level: warn\n      logs_console_output: false",
        )
    if not exec_module:
        marker = (
            "\n  # ── Exec Module (Python)"
            " ───────────────────────────────────────────────"
        )
        if marker not in content:
            raise RuntimeError("failed to remove ExecModule from iii config")
        content = content.split(marker, 1)[0].rstrip() + "\n"
    else:
        # Configuration generation must not restart active batch workers.
        content = content.replace("      watch:\n        - steps/**/*.py\n", "")
        motia_exec = "PYTHONUNBUFFERED=1 PYTHONPATH=. .venv/bin/motia dev --dir steps"
        single = f"      exec:\n        - {motia_exec}\n"
        if single not in content:
            raise RuntimeError("failed to expand Motia worker exec list in iii config")
        n = motia_worker_count()
        multi = "      exec:\n" + "".join(f"        - {motia_exec}\n" for _ in range(n))
        content = content.replace(single, multi, 1)
    tmp = tempfile.NamedTemporaryFile(
        mode="w", suffix=".yaml", prefix="iii-config-", dir=workflow_dir, delete=False
    )
    tmp.write(content)
    tmp.close()
    return tmp.name


def user_preferred_port(start: int, end: int) -> int:
    size = end - start + 1
    offset = (os.getuid() * 37 + os.getpid()) % size
    return start + offset


def cleanup_config(config_path: str):
    """Remove temp config file, ignoring if already deleted."""
    try:
        os.unlink(config_path)
    except FileNotFoundError:
        pass


def load_host_environment() -> None:
    """Import the host login-shell environment used by the EDA tools."""
    result = subprocess.run(
        ["zsh", "-lic", "env -0"],
        check=True,
        capture_output=True,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    for item in result.stdout.split(b"\0"):
        if item:
            key, value = item.split(b"=", 1)
            os.environ[key.decode()] = value.decode()


def parse_args(argv: list[str]) -> argparse.Namespace:
    try:
        argv = _normalize_workflow_args(argv)
    except ValueError as e:
        print(f"bbdev: error: {e}", file=sys.stderr)
        sys.exit(2)

    parser = argparse.ArgumentParser(
        prog="bbdev",
        description=(
            "Development tool for buckyball project.\n"
            "Exactly one of --device <device>, --hart <hart>, --thread <thread>, --ball <ball> names\n"
            "the component to simulate, from its default config (a device: the one\n"
            "<Design>DefaultConfig.toml of its design). --config <config> picks another config: a\n"
            "config TOML Top relative to examples/designs, e.g. toy/devices/toy/configs/ToyGemvConfig.toml."
        ),
        formatter_class=argparse.RawTextHelpFormatter,
    )

    # Global parameters shared across all subcommands
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--port", type=int, default=None, help="Port for dev server (default: auto)"
    )
    common.add_argument("--server", action="store_true", help="Server mode")

    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # start / stop
    subparsers.add_parser("start", parents=[common], help="Start dev server")
    stop_parser = subparsers.add_parser(
        "stop", parents=[common], help="Stop dev server"
    )
    stop_parser.add_argument("--all", action="store_true", help="Stop all servers")

    # Build workflow subcommands from WORKFLOW_COMMANDS table
    for cmd_name, operations in WORKFLOW_COMMANDS.items():
        cmd_parser = subparsers.add_parser(
            cmd_name, parents=[common], help=f"{cmd_name} operations"
        )
        group = cmd_parser.add_mutually_exclusive_group(required=True)
        for op_name, op_help in operations.items():
            if op_help is True:
                group.add_argument(
                    f"--{op_name}",
                    dest=op_name,
                    action="store_true",
                    help=f"{op_name.capitalize()}.",
                )
            else:
                group.add_argument(
                    f"--{op_name}",
                    dest=op_name,
                    type=str,
                    nargs="?",
                    const="",
                    metavar="ARGS",
                    help=op_help,
                )

    return parser.parse_args(argv)


def _normalize_workflow_args(argv: list[str]) -> list[str]:
    """Attach operation sub-arguments to the operation flag before argparse sees them."""
    if not argv:
        return argv

    command = argv[0]
    if command not in WORKFLOW_COMMANDS:
        return argv

    operations = WORKFLOW_COMMANDS[command]
    out = [command]
    i = 1
    while i < len(argv):
        token = argv[i]
        if token.startswith("--") and "=" in token:
            op_name, _value = token[2:].split("=", 1)
            if op_name in operations and operations[op_name] is not True:
                raise ValueError(
                    f"--{op_name} sub-arguments must be passed as a separate quoted"
                    " string"
                )
        if token.startswith("--") and "=" not in token:
            op_name = token[2:]
            if op_name in operations and operations[op_name] is not True:
                values = []
                j = i + 1
                while j < len(argv):
                    next_token = argv[j]
                    next_key = (
                        next_token[2:].split("=", 1)[0]
                        if next_token.startswith("--")
                        else ""
                    )
                    if next_key in operations:
                        break
                    values.append(next_token)
                    j += 1
                if values:
                    if len(values) > 1 and values[0].startswith("--"):
                        raise ValueError(
                            f"{token} sub-arguments must be quoted as one string"
                        )
                    value = values[0] if len(values) == 1 else shlex.join(values)
                    out.append(f"{token}={value}")
                else:
                    out.append(token)
                i = j
                continue
        out.append(token)
        i += 1

    return out


def extract_command_info(args: argparse.Namespace) -> dict:
    """Extract command, operation, and parsed sub-arguments from argparse Namespace."""
    result = {"command": args.command, "operation": None, "args": {}}

    for attr_name, attr_value in vars(args).items():
        if attr_name in ("command", "port", "server"):
            continue
        if attr_value is None or attr_value is False:
            continue

        result["operation"] = attr_name
        if attr_value is True or attr_value == "":
            result["args"] = {}
        else:
            try:
                result["args"] = _parse_sub_args(attr_value)
            except ValueError as e:
                print(f"bbdev: error: {e}", file=sys.stderr)
                sys.exit(2)
        break

    return result


def _parse_sub_args(arg_string: str) -> dict:
    """Parse a sub-argument string like '--test <name> --batch' into a dict."""
    args_dict = {}
    try:
        tokens = shlex.split(arg_string)
    except ValueError as e:
        raise ValueError(f"failed to parse sub-arguments: {e}") from e

    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token.startswith("--"):
            if "=" in token:
                key, value = token[2:].split("=", 1)
                if not key or value == "":
                    raise ValueError(f"Invalid argument: {token}")
                if value in ("true", "false"):
                    value = value == "true"
                args_dict[key] = value
                i += 1
            else:
                key = token[2:]
                if not key:
                    raise ValueError(f"Invalid argument: {token}")
                if i + 1 < len(tokens) and not tokens[i + 1].startswith("--"):
                    args_dict[key] = tokens[i + 1]
                    i += 2
                else:
                    args_dict[key] = True
                    i += 1
        elif token.startswith("-") and len(token) == 2:
            key = token[1:]
            if i + 1 < len(tokens) and not tokens[i + 1].startswith("--"):
                args_dict[key] = tokens[i + 1]
                i += 2
            else:
                args_dict[key] = True
                i += 1
        else:
            raise ValueError(f"Unexpected argument: {token}")
    unknown = args_dict.keys() & {"log-dir", "log_dir", "fst-dir", "fst_dir"}
    if unknown:
        raise ValueError(f"Unknown parameter(s): {', '.join(sorted(unknown))}")
    if "arguments" in args_dict:
        values = json.loads(args_dict["arguments"])
        if not isinstance(values, list) or not all(
            isinstance(value, str) for value in values
        ):
            raise ValueError("arguments must be a JSON list of strings")
        args_dict["arguments"] = values
    return args_dict


def wait_for_http(url: str, check_fn, timeout: int, error_msg: str):
    """Wait for an actual HTTP response satisfying the readiness predicate."""
    deadline = time.monotonic() + timeout
    with requests.Session() as session:
        session.trust_env = False
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            try:
                response = session.get(url, timeout=min(1, remaining))
                if check_fn(response):
                    return True
            except requests.exceptions.RequestException:
                pass
            remaining = deadline - time.monotonic()
            if remaining > 0:
                time.sleep(min(1, remaining))
    print(error_msg)
    return False


# If you find that bbdev has failed without any logs,
# you can disable these log filters. These contain the bbdev runtime logs.
def forward_iii_output(pipe, active_event: threading.Event, quiet: bool = False):
    """Forward task output to stdout. In quiet mode, suppress engine infrastructure logs."""
    for line in iter(pipe.readline, ""):
        if not active_event.is_set():
            continue
        if quiet and not any(
            marker in line for marker in ("ERROR", "error:", "Error:")
        ):
            # Preserve failures even when infrastructure progress is suppressed.
            if any(
                module in line
                for module in (
                    "iii::modules::worker",
                    "iii::modules::config",
                    "iii::modules::rest_api",
                    "iii::modules::api",
                    "iii::modules::queue",
                    "iii::modules::state",
                    "iii::modules::pubsub",
                    "iii::modules::shell",
                    "iii::modules::telemetry",
                    "iii::builtins",
                    "iii::trigger",
                    "iii::function",
                    "function_name",
                    "service_name",
                    "iii::services",
                    "iii::workers",
                    "motia.runtime",
                    "motia.tracing",
                    "motia.cli",
                )
            ):
                continue
            sys.stdout.write(line)
            sys.stdout.flush()
        else:
            sys.stdout.write(line)
            sys.stdout.flush()
    pipe.close()


def read_state_file(path: str):
    """Read JSON from an iii state file (JSON + binary padding). Returns parsed dict or None."""
    try:
        with open(path, "r", errors="ignore") as f:
            raw = f.read()
        state_data, _ = json.JSONDecoder().raw_decode(raw)
        return state_data
    except (FileNotFoundError, json.JSONDecodeError, ValueError):
        return None


def run_server_mode(args, cmd_info):
    """Handle --server mode: interact with an already-running (or new) iii server."""
    command = cmd_info["command"]

    if command == "start":
        print(f"Starting dev server on port {args.port}")
        if not args.port:
            print("Error: --server start requires --port", file=sys.stderr)
            sys.exit(2)
        load_host_environment()
        worker_port_start, worker_port_end = 49200, 49500
        preferred_worker = user_preferred_port(worker_port_start, worker_port_end)
        worker_port, worker_sock = reserve_port(
            start_port=worker_port_start,
            end_port=worker_port_end,
            preferred_port=preferred_worker,
        )
        worker_sock.close()
        config_path = make_iii_config(args.port, worker_port)
        worker_url = f"ws://127.0.0.1:{worker_port}"
        print(f"Using worker port {worker_port} (preferred {preferred_worker})")
        proc = None
        try:
            repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
            write_server_ports(workflow_dir, args.port, worker_port, repo_root)
            env = {
                **os.environ,
                "PYTHONDONTWRITEBYTECODE": "1",
                "III_URL": worker_url,
            }
            proc = subprocess.Popen(
                ["iii", "-c", config_path],
                cwd=workflow_dir,
                env=env,
                start_new_session=True,
            )
            need = motia_worker_count()
            deadline = time.monotonic() + 60
            while time.monotonic() < deadline:
                if proc.poll() is not None:
                    sys.exit(proc.returncode or 1)
                try:
                    n = assert_sole_workspace_workers(
                        worker_port, repo_root, min_local=need
                    )
                    break
                except RuntimeError as e:
                    msg = str(e)
                    if "foreign Motia worker" in msg:
                        print(f"Error: {e}", file=sys.stderr)
                        sys.exit(1)
                    time.sleep(0.5)
                    continue
            else:
                print(
                    f"Error: need {need} Motia worker(s) from this workspace"
                    " within 60s",
                    file=sys.stderr,
                )
                sys.exit(1)
            print(f"Workspace Motia isolation ok: {n} worker(s) on port {worker_port}")
            rc = proc.wait()
            if rc != 0:
                sys.exit(rc)
        finally:
            if proc:
                terminate_group(proc)
            stop_workspace_servers(workflow_dir, worker_url=worker_url)
            cleanup_config(config_path)

    elif command == "stop":
        if cmd_info["operation"] == "all":
            count = stop_workspace_servers(workflow_dir)
            print(f"Stopped {count} process(es) for this workspace")
        else:
            count = stop_workspace_servers(workflow_dir, port=args.port)
            if args.port:
                print(f"Stopped {count} process(es) on port {args.port}")
            else:
                print(f"Stopped {count} process(es) for this workspace")

    elif command in WORKFLOW_COMMANDS:
        api_path = f"/{command.replace('-', '/')}/{cmd_info['operation']}"
        resp = requests.post(
            f"http://127.0.0.1:{args.port}{api_path}",
            json=cmd_info["args"],
            timeout=30,
            proxies={"http": None, "https": None, "all": None},
        )
        print(resp.text)

    else:
        print(f"Unknown command: {command}")
        print(f"Available commands: {', '.join(['start', 'stop', *WORKFLOW_COMMANDS])}")
        sys.exit(1)


def _submit_and_poll(port: int, api_path: str, cmd_info: dict, state_dir: str):
    """Submit a task to iii and poll for its result. Returns exit code (0=ok, 1=fail)."""
    base_url = f"http://127.0.0.1:{port}"
    print(f"Executing {cmd_info['command']} {cmd_info['operation']}...")
    try:
        submit_resp = requests.post(
            f"{base_url}{api_path}",
            json=cmd_info["args"],
            timeout=30,
            proxies={"http": None, "https": None, "all": None},
        )
        submit_data = submit_resp.json()
    except Exception as e:
        print(f"Error: Failed to submit task: {e}")
        return 1

    if submit_resp.status_code >= 400:
        print(f"Error: {submit_data}")
        return 1

    trace_id = submit_data.get("trace_id", "")
    if not trace_id:
        print(f"Error: No trace_id in response: {submit_data}")
        return 1

    # Poll for result
    state_file = os.path.join(state_dir, f"{trace_id}.bin")
    poll_timeout = 24 * 60 * 60  # 24 hours max
    task_result = None
    legacy_processing_count = 0
    last_heartbeat = time.monotonic()
    for _ in range(poll_timeout // 2):
        state_data = read_state_file(state_file)
        if state_data:
            if "success" in state_data:
                task_result = state_data["success"].get("body", state_data["success"])
                break
            elif "failure" in state_data:
                task_result = state_data["failure"].get("body", state_data["failure"])
                break
            elif state_data.get("processing") is True:
                legacy_processing_count += 1
                if legacy_processing_count >= 30:
                    print(
                        "Error: Task is stuck in legacy processing state; worker did"
                        " not advance the queue"
                    )
                    return 1
            else:
                legacy_processing_count = 0
        now = time.monotonic()
        if now - last_heartbeat >= 600:
            print(f"[bbdev] still running trace {trace_id}...", flush=True)
            last_heartbeat = now
        time.sleep(2)
    else:
        print("Error: Task polling timed out after 24 hours")
        return 1

    print(f"\nTask completed on http://127.0.0.1:{port}")
    if task_result and not task_result.get("success", False):
        err = task_result.get("error") or task_result
        print(f"Error: Task failed: {err}")
        return 1
    return 0


def run_script_mode(args, cmd_info):
    """Handle script mode: start iii, run one task, then shut down."""
    command = cmd_info["command"]

    if command == "start":
        print(f"'{command}' does nothing in script mode")
        return
    if command == "stop":
        count = stop_workspace_servers(workflow_dir, port=args.port)
        if args.port:
            print(f"Stopped {count} process(es) on port {args.port}")
        else:
            print(f"Stopped {count} process(es) for this workspace")
        return

    if command not in WORKFLOW_COMMANDS:
        print(f"Unknown command: {command}")
        print(f"Available commands: {', '.join(['start', 'stop', *WORKFLOW_COMMANDS])}")
        sys.exit(1)

    load_host_environment()

    api_path = f"/{command.replace('-', '/')}/{cmd_info['operation']}"

    # Serialize only engine startup. The reservation socket must be released before
    # iii can bind it, so without this lock another bbdev can select the same port
    # during that handoff.
    server_start_lock_path = os.path.join(workflow_dir, "data", "server-start.lock")
    os.makedirs(os.path.dirname(server_start_lock_path), exist_ok=True)
    server_start_lock = open(server_start_lock_path, "w")
    fcntl.flock(server_start_lock, fcntl.LOCK_EX)

    # Above 5173 and the ports Vite falls back to: the bbbench site's.
    http_port_start, http_port_end = 5200, 5600
    worker_port_start, worker_port_end = 49200, 49500

    # Reserve both ports atomically to prevent TOCTOU races with concurrent bbdev instances.
    # Sockets stay bound until the engine has taken over (HTTP is up), then are released.
    if args.port:
        available_port = args.port
        http_sock = None
    else:
        available_port, http_sock = reserve_port(
            start_port=http_port_start,
            end_port=http_port_end,
            preferred_port=user_preferred_port(http_port_start, http_port_end),
        )
    worker_port, worker_sock = reserve_port(
        start_port=worker_port_start,
        end_port=worker_port_end,
        preferred_port=user_preferred_port(worker_port_start, worker_port_end),
    )
    print(f"Starting server on port {available_port}...")

    data_dir = os.path.join(workflow_dir, "data")
    os.makedirs(data_dir, exist_ok=True)
    state_dir = tempfile.mkdtemp(prefix="state-", dir=data_dir)
    clean_python_caches(workflow_dir)

    config_path = make_iii_config(
        available_port,
        worker_port,
        quiet=True,
        exec_module=False,
        state_dir=state_dir,
    )
    iii_output_active = threading.Event()
    iii_output_active.set()

    # Release reserved sockets just before engine starts so it can bind the same ports.
    if http_sock:
        http_sock.close()
    worker_sock.close()

    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    # Set III_URL so motia SDK connects to the correct worker port
    iii_env = {
        **os.environ,
        "III_URL": f"ws://127.0.0.1:{worker_port}",
        "PYTHONUNBUFFERED": "1",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONDONTWRITEBYTECODE": "1",
    }
    worker_procs = []
    proc = subprocess.Popen(
        ["iii", "-c", config_path],
        cwd=workflow_dir,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        env=iii_env,
        start_new_session=True,
    )

    output_thread = threading.Thread(
        target=forward_iii_output,
        args=(proc.stdout, iii_output_active, True),
        daemon=True,
    )
    output_thread.start()

    try:
        base_url = f"http://127.0.0.1:{available_port}"

        # Phase 1: wait for iii engine HTTP
        if not wait_for_http(
            f"{base_url}/",
            check_fn=lambda r: True,
            timeout=120,
            error_msg="Server failed to start within 120 seconds",
        ):
            sys.exit(1)

        need = motia_worker_count()
        for _ in range(need):
            worker_proc = subprocess.Popen(
                [".venv/bin/motia", "dev", "--dir", "steps"],
                cwd=workflow_dir,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                env=iii_env,
                start_new_session=True,
            )
            worker_procs.append(worker_proc)
            worker_output_thread = threading.Thread(
                target=forward_iii_output,
                args=(worker_proc.stdout, iii_output_active, True),
                daemon=True,
            )
            worker_output_thread.start()

        # Phase 2: wait for route registration
        if not wait_for_http(
            f"{base_url}{api_path}",
            check_fn=lambda r: r.status_code != 404,
            timeout=120,
            error_msg="Routes failed to register within timeout",
        ):
            sys.exit(1)
        time.sleep(2)

        try:
            n = assert_sole_workspace_workers(worker_port, repo_root, min_local=need)
        except RuntimeError as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)

        fcntl.flock(server_start_lock, fcntl.LOCK_UN)
        server_start_lock.close()
        server_start_lock = None

        print(f"Server is ready on port {available_port} with {n} Motia worker(s)")
        rc = _submit_and_poll(available_port, api_path, cmd_info, state_dir)
        if rc != 0:
            sys.exit(rc)

    finally:
        # Keep released ports reserved against new startup until worker cleanup ends.
        if server_start_lock is None:
            server_start_lock = open(server_start_lock_path, "w")
            fcntl.flock(server_start_lock, fcntl.LOCK_EX)
        try:
            iii_output_active.clear()
            time.sleep(0.5)
            for worker_proc in worker_procs:
                terminate_group(worker_proc)
            terminate_group(proc)
            stop_workspace_servers(workflow_dir, worker_url=iii_env["III_URL"])
            cleanup_config(config_path)
            shutil.rmtree(state_dir)
        finally:
            fcntl.flock(server_start_lock, fcntl.LOCK_UN)
            server_start_lock.close()


if __name__ == "__main__":
    # A terminated CLI unwinds like an interrupted one, so the server it
    # started and the tasks of that server stop with it.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    args = parse_args(sys.argv[1:])
    cmd_info = extract_command_info(args)

    if args.server:
        run_server_mode(args, cmd_info)
    else:
        run_script_mode(args, cmd_info)
