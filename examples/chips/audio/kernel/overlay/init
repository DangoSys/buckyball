#!/bin/sh
set -e

[ -c /dev/console ] || {
  echo "ERROR: /dev/console is missing or not a character device" >&2
  exit 1
}

[ -c /dev/null ] || {
  echo "ERROR: /dev/null is missing or not a character device" >&2
  exit 1
}

exec </dev/console >/dev/console 2>&1

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

echo ""
echo "[audio] pk regression via /init"
echo ""

fail_exit() {
  echo "$1" >&2
  reboot -f
}

count=0
for t in /root/*-linux; do
  [ -e "$t" ] || continue
  count=$((count + 1))
  echo "[audio] run $t"
  if ! "$t"; then
    fail_exit "[audio] FAIL: $t"
  fi
done

[ "$count" -gt 0 ] || fail_exit "[audio] ERROR: no /root/*-linux tests found"

echo "[audio] all ok"
reboot -f
