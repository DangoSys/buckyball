func.func private @check_result(memref<16x16xi32>) -> ()
func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %initial = arith.constant -5 : i32
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %two = arith.constant 2 : index
  %three = arith.constant 3 : index
  %five = arith.constant 5 : index
  %seven = arith.constant 7 : index
  %sixteen = arith.constant 16 : index
  %depth = arith.constant @BB_BANK_LINES@ : index
  %at = memref.alloc() alignment = 64 : memref<@BB_BANK_LINES@x16xi8>
  %b = memref.alloc() alignment = 64 : memref<@BB_BANK_LINES@x16xi8>
  %c = memref.alloc() alignment = 64 : memref<16x16xi32>
  linalg.fill ins(%initial : i32) outs(%c : memref<16x16xi32>)
  scf.for %k = %zero to %depth step %one {
    scf.for %lane = %zero to %sixteen step %one {
      %k3 = arith.muli %k, %three : index
      %l5 = arith.muli %lane, %five : index
      %asum = arith.addi %k3, %l5 : index
      %arem = arith.remui %asum, %seven : index
      %aval = arith.subi %arem, %three : index
      %av = arith.index_cast %aval : index to i8
      %k2 = arith.muli %k, %two : index
      %l3 = arith.muli %lane, %three : index
      %bsum = arith.addi %k2, %l3 : index
      %brem = arith.remui %bsum, %five : index
      %bval = arith.subi %brem, %two : index
      %bv = arith.index_cast %bval : index to i8
      memref.store %av, %at[%k, %lane] : memref<@BB_BANK_LINES@x16xi8>
      memref.store %bv, %b[%k, %lane] : memref<@BB_BANK_LINES@x16xi8>
    }
  }
  %ab = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %bb = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %cb = buckyball.bank_alloc <{row = 1 : i64, col = 4 : i64}>
  %al = buckyball.bank_mvin %at, %ab <{depth = @BB_BANK_LINES@ : i64, stride = 1 : i64}>
      : memref<@BB_BANK_LINES@x16xi8>
  %bl = buckyball.bank_mvin %b, %bb <{depth = @BB_BANK_LINES@ : i64, stride = 1 : i64}>
      : memref<@BB_BANK_LINES@x16xi8>
  %cl = buckyball.bank_mvin %c, %cb <{depth = 16 : i64, stride = 1 : i64}>
      : memref<16x16xi32>
  // C += A^T * B with K the bank depth.
  %result = vector_ball.bank_matmul_at_i8 %al, %bl -> %cl
      <{rows = @BB_BANK_LINES@ : i64}>
  %stored = buckyball.bank_mvout %c, %result <{depth = 16 : i64, stride = 1 : i64}>
      : memref<16x16xi32>
  buckyball.bank_release %al
  buckyball.bank_release %bl
  buckyball.bank_release %stored
  func.call @check_result(%c) : (memref<16x16xi32>) -> ()
  memref.dealloc %at : memref<@BB_BANK_LINES@x16xi8>
  memref.dealloc %b : memref<@BB_BANK_LINES@x16xi8>
  memref.dealloc %c : memref<16x16xi32>
  return %zero_i8 : i8
}
