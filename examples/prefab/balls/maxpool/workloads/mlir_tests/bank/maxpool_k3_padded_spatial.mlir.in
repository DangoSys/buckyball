func.func private @check_result(memref<@BANK_LINES@x@BANK_I8_LANES@xi8>) -> ()
func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %rows = arith.constant @BANK_LINES@ : index
  %batch_rows = arith.constant 64 : index
  %lanes = arith.constant @BANK_I8_LANES@ : index
  %mod = arith.constant 31 : index
  %bias = arith.constant 15 : index
  %input = memref.alloc() : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  %output = memref.alloc() : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  scf.for %row = %zero to %rows step %one {
    %wrapped = arith.remui %row, %mod : index
    %signed = arith.subi %wrapped, %bias : index
    %value = arith.index_cast %signed : index to i8
    scf.for %lane = %zero to %lanes step %one {
      memref.store %value, %input[%row, %lane] : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
      memref.store %zero_i8, %output[%row, %lane] : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
    }
  }
  scf.for %base = %zero to %rows step %batch_rows {
    %in = memref.subview %input[%base, 0] [64, @BANK_I8_LANES@] [1, 1] : memref<@BANK_LINES@x@BANK_I8_LANES@xi8> to memref<64x@BANK_I8_LANES@xi8, strided<[@BANK_I8_LANES@, 1], offset: ?>>
    %out = memref.subview %output[%base, 0] [64, @BANK_I8_LANES@] [1, 1] : memref<@BANK_LINES@x@BANK_I8_LANES@xi8> to memref<64x@BANK_I8_LANES@xi8, strided<[@BANK_I8_LANES@, 1], offset: ?>>
    %in_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
    %out_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
    %loaded = bbacc.bank_mvin %in, %in_bank <{depth = 64 : i64, stride = 1 : i64}> : memref<64x@BANK_I8_LANES@xi8, strided<[@BANK_I8_LANES@, 1], offset: ?>>
    %result = maxpool_ball.bank_maxpool_i8 %loaded -> %out_bank <{input_side = 8 : i64, kernel = 3 : i64, stride = 1 : i64, padding = 1 : i64}>
    %stored = bbacc.bank_mvout %out, %result <{depth = 64 : i64, stride = 1 : i64}> : memref<64x@BANK_I8_LANES@xi8, strided<[@BANK_I8_LANES@, 1], offset: ?>>
    bbacc.bank_release %loaded
    bbacc.bank_release %stored
  }
  func.call @check_result(%output) : (memref<@BANK_LINES@x@BANK_I8_LANES@xi8>) -> ()
  memref.dealloc %input : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  memref.dealloc %output : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  return %zero_i8 : i8
}
