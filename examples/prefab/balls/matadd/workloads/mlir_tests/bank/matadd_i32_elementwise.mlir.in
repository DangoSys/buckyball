func.func private @check_result(memref<@BANK_LINES@x@BANK_I32_LANES@xi32>) -> ()

func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %rows = arith.constant @BANK_LINES@ : index
  %lanes = arith.constant @BANK_I32_LANES@ : index
  %a = memref.alloc() : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  %b = memref.alloc() : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  %out = memref.alloc() : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  scf.for %row = %zero to %rows step %one {
    scf.for %lane = %zero to %lanes step %one {
      %r = arith.index_cast %row : index to i32
      %l = arith.index_cast %lane : index to i32
      %x = arith.addi %r, %l : i32
      %y = arith.subi %l, %r : i32
      memref.store %x, %a[%row, %lane] : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
      memref.store %y, %b[%row, %lane] : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
    }
  }
  %a_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %b_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %out_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %a_loaded = bbacc.bank_mvin %a, %a_bank <{depth = @BANK_LINES@ : i64, stride = 1 : i64}>
      : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  %b_loaded = bbacc.bank_mvin %b, %b_bank <{depth = @BANK_LINES@ : i64, stride = 1 : i64}>
      : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  %result = matadd_ball.bank_add_i32 %a_loaded, %b_loaded -> %out_bank <{rows = @BANK_LINES@ : i64}>
  %stored = bbacc.bank_mvout %out, %result <{depth = @BANK_LINES@ : i64, stride = 1 : i64}>
      : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  bbacc.bank_release %a_loaded
  bbacc.bank_release %b_loaded
  bbacc.bank_release %stored
  func.call @check_result(%out) : (memref<@BANK_LINES@x@BANK_I32_LANES@xi32>) -> ()
  memref.dealloc %a : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  memref.dealloc %b : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  memref.dealloc %out : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  return %zero_i8 : i8
}
