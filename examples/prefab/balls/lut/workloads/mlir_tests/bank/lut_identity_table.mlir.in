func.func private @check_result(memref<@BANK_LINES@x@BANK_I8_LANES@xi8>) -> ()

func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %rows = arith.constant @BANK_LINES@ : index
  %lanes = arith.constant @BANK_I8_LANES@ : index
  %sixteen = arith.constant 16 : index
  %lanes_i32 = arith.constant @BANK_I8_LANES@ : i32
  %sixteen_i32 = arith.constant 16 : i32
  %input = memref.alloc() : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  %table = memref.alloc() : memref<16x16xi8>
  %output = memref.alloc() : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  scf.for %row = %zero to %sixteen step %one {
    scf.for %lane = %zero to %sixteen step %one {
      %row32 = arith.index_cast %row : index to i32
      %lane32 = arith.index_cast %lane : index to i32
      %base = arith.muli %row32, %sixteen_i32 : i32
      %index = arith.addi %base, %lane32 : i32
      %value = arith.trunci %index : i32 to i8
      memref.store %value, %table[%row, %lane] : memref<16x16xi8>
    }
  }
  scf.for %row = %zero to %rows step %one {
    scf.for %lane = %zero to %lanes step %one {
      %row32 = arith.index_cast %row : index to i32
      %lane32 = arith.index_cast %lane : index to i32
      %base = arith.muli %row32, %lanes_i32 : i32
      %index = arith.addi %base, %lane32 : i32
      %value = arith.trunci %index : i32 to i8
      memref.store %value, %input[%row, %lane] : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
    }
  }
  %input_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %table_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %output_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %loaded_input = bbacc.bank_mvin %input, %input_bank <{depth = @BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  %loaded_table = bbacc.bank_mvin %table, %table_bank <{depth = 16 : i64, stride = 1 : i64}> : memref<16x16xi8>
  %result = lut_ball.bank_lookup_i8 %loaded_input, %loaded_table -> %output_bank <{rows = @BANK_LINES@ : i64}>
  %stored = bbacc.bank_mvout %output, %result <{depth = @BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  bbacc.bank_release %loaded_input
  bbacc.bank_release %loaded_table
  bbacc.bank_release %stored
  func.call @check_result(%output) : (memref<@BANK_LINES@x@BANK_I8_LANES@xi8>) -> ()
  memref.dealloc %input : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  memref.dealloc %table : memref<16x16xi8>
  memref.dealloc %output : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  return %zero_i8 : i8
}
