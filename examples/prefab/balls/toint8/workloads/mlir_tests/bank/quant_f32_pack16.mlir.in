func.func private @check_result(memref<@BB_QUANT_I32_OUTPUT_ROWS@x@BANK_I8_LANES@xi8>) -> ()
func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %four = arith.constant 4 : index
  %sixteen = arith.constant 16 : index
  %rows = arith.constant @BB_QUANT_I32_OUTPUT_ROWS@ : index
  %scale = arith.constant 1.0 : f32
  %input = memref.alloc() : memref<@BANK_LINES@x4xf32>
  %scales = memref.alloc() : memref<4x4xf32>
  linalg.fill ins(%scale : f32) outs(%scales : memref<4x4xf32>)
  %output = memref.alloc() : memref<@BB_QUANT_I32_OUTPUT_ROWS@x@BANK_I8_LANES@xi8>
  scf.for %position = %zero to %rows step %one {
    scf.for %channel = %zero to %sixteen step %one {
      %base = arith.muli %position, %sixteen : index
      %linear = arith.addi %base, %channel : index
      %value_i32 = arith.index_cast %linear : index to i32
      %value = arith.sitofp %value_i32 : i32 to f32
      %row_base = arith.muli %position, %four : index
      %channel_row = arith.divui %channel, %four : index
      %row = arith.addi %row_base, %channel_row : index
      %lane = arith.remui %channel, %four : index
      memref.store %value, %input[%row, %lane] : memref<@BANK_LINES@x4xf32>
    }
  }
  %input_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %scale_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %output_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %loaded_input = bbacc.bank_mvin %input, %input_bank <{depth = @BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BANK_LINES@x4xf32>
  %loaded_scales = bbacc.bank_mvin %scales, %scale_bank <{depth = 4 : i64, stride = 1 : i64}> : memref<4x4xf32>
  %result = toint8_ball.bank_fp32_to_int8 %loaded_input, %loaded_scales -> %output_bank <{rows = @BANK_LINES@ : i64}>
  %stored = bbacc.bank_mvout %output, %result <{depth = @BB_QUANT_I32_OUTPUT_ROWS@ : i64, stride = 1 : i64}> : memref<@BB_QUANT_I32_OUTPUT_ROWS@x@BANK_I8_LANES@xi8>
  func.call @check_result(%output) : (memref<@BB_QUANT_I32_OUTPUT_ROWS@x@BANK_I8_LANES@xi8>) -> ()
  bbacc.bank_release %loaded_input
  bbacc.bank_release %loaded_scales
  bbacc.bank_release %stored
  memref.dealloc %input : memref<@BANK_LINES@x4xf32>
  memref.dealloc %scales : memref<4x4xf32>
  memref.dealloc %output : memref<@BB_QUANT_I32_OUTPUT_ROWS@x@BANK_I8_LANES@xi8>
  return %zero_i8 : i8
}
