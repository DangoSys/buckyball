func.func private @check_result(memref<@BANK_LINES@x@BANK_I8_LANES@xi8>) -> ()

func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %mod = arith.constant 31 : index
  %rows = arith.constant @BANK_LINES@ : index
  %lanes = arith.constant @BANK_I8_LANES@ : index
  %ratio = arith.constant 1.0 : f32
  %a = memref.alloc() : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  %b = memref.alloc() : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  %out = memref.alloc() : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  scf.for %row = %zero to %rows step %one {
    scf.for %lane = %zero to %lanes step %one {
      %row_mod = arith.remui %row, %mod : index
      %r = arith.index_cast %row_mod : index to i32
      %l = arith.index_cast %lane : index to i32
      %a32 = arith.subi %l, %r : i32
      %b32 = arith.subi %r, %l : i32
      %a8 = arith.trunci %a32 : i32 to i8
      %b8 = arith.trunci %b32 : i32 to i8
      memref.store %a8, %a[%row, %lane] : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
      memref.store %b8, %b[%row, %lane] : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
    }
  }
  %a_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %b_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %out_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %a_loaded = bbacc.bank_mvin %a, %a_bank <{depth = @BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  %b_loaded = bbacc.bank_mvin %b, %b_bank <{depth = @BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  %result = int8add_ball.bank_add_i8 %a_loaded, %b_loaded -> %out_bank ratios(%ratio, %ratio) <{rows = @BANK_LINES@ : i64}>
  %stored = bbacc.bank_mvout %out, %result <{depth = @BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  bbacc.bank_release %a_loaded
  bbacc.bank_release %b_loaded
  bbacc.bank_release %stored
  func.call @check_result(%out) : (memref<@BANK_LINES@x@BANK_I8_LANES@xi8>) -> ()
  memref.dealloc %a : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  memref.dealloc %b : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  memref.dealloc %out : memref<@BANK_LINES@x@BANK_I8_LANES@xi8>
  return %zero_i8 : i8
}
