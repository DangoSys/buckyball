func.func private @check_result(memref<@BANK_LINES@x8xf16>) -> ()
func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %two = arith.constant 2 : index
  %eight = arith.constant 8 : index
  %rows = arith.constant @BANK_LINES@ : index
  %pos_one = arith.constant 1.0 : f16
  %neg_one = arith.constant -1.0 : f16
  %pos_half = arith.constant 0.5 : f16
  %neg_half = arith.constant -0.5 : f16
  %a = memref.alloc() alignment = 64 : memref<@BANK_LINES@x8xf16>
  %b = memref.alloc() alignment = 64 : memref<8x8xf16>
  %c = memref.alloc() alignment = 64 : memref<@BANK_LINES@x8xf16>
  scf.for %row = %zero to %rows step %one {
    %parity = arith.remui %row, %two : index
    %odd = arith.cmpi eq, %parity, %one : index
    %value = arith.select %odd, %neg_one, %pos_one : f16
    scf.for %lane = %zero to %eight step %one {
      memref.store %value, %a[%row, %lane] : memref<@BANK_LINES@x8xf16>
    }
  }
  scf.for %k = %zero to %eight step %one {
    scf.for %lane = %zero to %eight step %one {
      %parity = arith.remui %lane, %two : index
      %odd = arith.cmpi eq, %parity, %one : index
      %value = arith.select %odd, %neg_half, %pos_half : f16
      memref.store %value, %b[%k, %lane] : memref<8x8xf16>
    }
  }
  %a_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %b_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %c_bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %loaded_a = bbacc.bank_mvin %a, %a_bank <{depth = @BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BANK_LINES@x8xf16>
  %loaded_b = bbacc.bank_mvin %b, %b_bank <{depth = 8 : i64, stride = 1 : i64}> : memref<8x8xf16>
  %result = redmule_ball.bank_matmul_f16 %loaded_a, %loaded_b -> %c_bank
      <{rows = @BANK_LINES@ : i64, k = 8 : i64}>
  %stored = bbacc.bank_mvout %c, %result <{depth = @BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BANK_LINES@x8xf16>
  bbacc.bank_release %loaded_a
  bbacc.bank_release %loaded_b
  bbacc.bank_release %stored
  func.call @check_result(%c) : (memref<@BANK_LINES@x8xf16>) -> ()
  memref.dealloc %a : memref<@BANK_LINES@x8xf16>
  memref.dealloc %b : memref<8x8xf16>
  memref.dealloc %c : memref<@BANK_LINES@x8xf16>
  return %zero_i8 : i8
}
