func.func private @check_result(memref<@BANK_LINES@x@BANK_I32_LANES@xi32>) -> ()

func.func @main() -> i8 {
  %zeroI8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %limit = arith.constant @BANK_LINES@ : index
  %lanes = arith.constant @BANK_I32_LANES@ : index
  %lane_count = arith.constant @BANK_I32_LANES@ : i32
  %seventeen = arith.constant 17 : i32
  %bias = arith.constant 8 : i32

  %input = memref.alloc() alignment = 64 : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  %output = memref.alloc() alignment = 64 : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>

  scf.for %line = %zero to %limit step %one {
    scf.for %lane = %zero to %lanes step %one {
      %line_i32 = arith.index_cast %line : index to i32
      %lane_i32 = arith.index_cast %lane : index to i32
      %base = arith.muli %line_i32, %lane_count : i32
      %index = arith.addi %base, %lane_i32 : i32
      %remainder = arith.remui %index, %seventeen : i32
      %signed = arith.subi %remainder, %bias : i32
      memref.store %signed, %input[%line, %lane] : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
    }
  }

  %bank = bbacc.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %loaded = bbacc.bank_mvin %input, %bank <{depth = @BANK_LINES@ : i64, stride = 1 : i64}>
      : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  %result = relu_ball.bank_relu_i32 %loaded
      <{rows = @BANK_LINES@ : i64}>
  %stored = bbacc.bank_mvout %output, %result <{depth = @BANK_LINES@ : i64, stride = 1 : i64}>
      : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  bbacc.bank_release %stored

  func.call @check_result(%output) : (memref<@BANK_LINES@x@BANK_I32_LANES@xi32>) -> ()
  memref.dealloc %input : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  memref.dealloc %output : memref<@BANK_LINES@x@BANK_I32_LANES@xi32>
  return %zeroI8 : i8
}
