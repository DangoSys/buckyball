// CHECK-LABEL: func.func @quant_layout
// CHECK-COUNT-4: call @mxfp8_quant
// CHECK-NOT: call @mxfp8_quant
// CHECK: return
func.func @quant_layout(%x: tensor<16x64xf32>) -> (tensor<@PACKED_BYTES@xi8>,tensor<@PACKED_BYTES@xi8>,tensor<@DOUBLE_PACKED_BYTES@xi8>,tensor<@PACKED_BYTES@xi8>) {
  %q0 = buckyball.mxfp8_quant %x {tile_rows=16:i64,tile_k=64:i64,bank_bytes=@PACKED_BYTES@:i64} : tensor<16x64xf32> -> tensor<@PACKED_BYTES@xi8>
  %q1 = buckyball.mxfp8_quant %x {tile_rows=32:i64,tile_k=64:i64,bank_bytes=@PACKED_BYTES@:i64} : tensor<16x64xf32> -> tensor<@PACKED_BYTES@xi8>
  %q2 = buckyball.mxfp8_quant %x {tile_rows=16:i64,tile_k=32:i64,bank_bytes=@PACKED_BYTES@:i64} : tensor<16x64xf32> -> tensor<@DOUBLE_PACKED_BYTES@xi8>
  %q3 = buckyball.mxfp8_quant %x {tile_rows=16:i64,tile_k=32:i64,bank_bytes=@HALF_PACKED_BYTES@:i64} : tensor<16x64xf32> -> tensor<@PACKED_BYTES@xi8>
  return %q0,%q1,%q2,%q3 : tensor<@PACKED_BYTES@xi8>,tensor<@PACKED_BYTES@xi8>,tensor<@DOUBLE_PACKED_BYTES@xi8>,tensor<@PACKED_BYTES@xi8>
}
