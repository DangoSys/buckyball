func.func private @check_result(memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>) -> ()
func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %rows = arith.constant @BB_BANK_LINES@ : index
  %batch_rows = arith.constant 64 : index
  %lanes = arith.constant @BB_BANK_I8_LANES@ : index
  %mod = arith.constant 31 : index
  %bias = arith.constant 15 : index
  %depth = arith.constant 64 : i64
  %zero64 = arith.constant 0 : i64
  %side64 = arith.constant 8 : i64
  %stride = arith.constant 1 : i64
  %input = memref.alloc() : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
  %output = memref.alloc() : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
  scf.for %row = %zero to %rows step %one {
    %wrapped = arith.remui %row, %mod : index
    %signed = arith.subi %wrapped, %bias : index
    %value = arith.index_cast %signed : index to i8
    scf.for %lane = %zero to %lanes step %one {
      memref.store %value, %input[%row, %lane] : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
      memref.store %zero_i8, %output[%row, %lane] : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
    }
  }
  %in_bank = buckyball.bank_alloc
  %out_bank = buckyball.bank_alloc
  %final:2 = scf.for %base = %zero to %rows step %batch_rows iter_args(%ib = %in_bank, %ob = %out_bank) -> (i64, i64) {
    %in = memref.subview %input[%base, 0] [64, @BB_BANK_I8_LANES@] [1, 1] : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8> to memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>>
    %out = memref.subview %output[%base, 0] [64, @BB_BANK_I8_LANES@] [1, 1] : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8> to memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>>
    %loaded_input = buckyball.bank_mvin %in %ib %depth %stride : memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>> i64 i64 i64
    %loaded_output = buckyball.bank_mvin %out %ob %depth %stride : memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>> i64 i64 i64
    %result = buckyball.bank_maxpool %loaded_input %loaded_output %depth %zero64 %zero64 %side64 <inputSide = 8, outputSide = 8, kernel = 3, stride = 1, padding = 1, startRow = 0, startCol = 0> : i64 i64 i64 i64 i64 i64
    %stored = buckyball.bank_mvout %out %result %depth %stride : memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>> i64 i64 i64
    scf.yield %loaded_input, %stored : i64, i64
  }
  func.call @check_result(%output) : (memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>) -> ()
  buckyball.bank_release %final#0 : i64
  buckyball.bank_release %final#1 : i64
  return %zero_i8 : i8
}
