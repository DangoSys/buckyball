func.func private @check_result(memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xf32>) -> ()
func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %rows = arith.constant @BB_BANK_LINES@ : index
  %lanes = arith.constant @BB_BANK_I32_LANES@ : index
  %input = memref.alloc() : memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xi32>
  %scale = memref.alloc() : memref<4x4xf32>
  %output = memref.alloc() : memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xf32>
  %one_f32 = arith.constant 1.0 : f32
  linalg.fill ins(%one_f32 : f32) outs(%scale : memref<4x4xf32>)
  scf.for %row = %zero to %rows step %one {
    scf.for %lane = %zero to %lanes step %one {
      %r = arith.index_cast %row : index to i32
      %l = arith.index_cast %lane : index to i32
      %value = arith.subi %r, %l : i32
      memref.store %value, %input[%row, %lane] : memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xi32>
    }
  }
  %input_bank = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %scale_bank = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %output_bank = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %loaded_input = buckyball.bank_mvin %input, %input_bank <{depth = @BB_BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xi32>
  %loaded_scale = buckyball.bank_mvin %scale, %scale_bank <{depth = 4 : i64, stride = 1 : i64}> : memref<4x4xf32>
  %result = buckyball.bank_custom "int32_to_fp32" (%loaded_input, %loaded_scale) -> %output_bank {rows = @BB_INT2FP_ROWS@ : i64, relu = false}
  %stored = buckyball.bank_mvout %output, %result <{depth = @BB_BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xf32>
  func.call @check_result(%output) : (memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xf32>) -> ()
  buckyball.bank_release %loaded_input
  buckyball.bank_release %loaded_scale
  buckyball.bank_release %stored
  memref.dealloc %input : memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xi32>
  memref.dealloc %scale : memref<4x4xf32>
  memref.dealloc %output : memref<@BB_BANK_LINES@x@BB_BANK_I32_LANES@xf32>
  return %zero_i8 : i8
}
