func.func private @check_result(memref<@BB_BANK_LINES@x16xi32>) -> ()
func.func @main() -> i8 {
  %z8 = arith.constant 0 : i8
  %z32 = arith.constant 0 : i32
  %z = arith.constant 0 : index
  %one = arith.constant 1 : index
  %two = arith.constant 2 : index
  %three = arith.constant 3 : index
  %five = arith.constant 5 : index
  %seven = arith.constant 7 : index
  %dim = arith.constant 16 : index
  %rows = arith.constant @BB_BANK_LINES@ : index
  %zero64 = arith.constant 0 : i64
  %a = memref.alloc() : memref<@BB_BANK_LINES@x16xi8>
  %b = memref.alloc() : memref<16x16xi8>
  %c = memref.alloc() : memref<@BB_BANK_LINES@x16xi32>
  linalg.fill ins(%z32 : i32) outs(%c : memref<@BB_BANK_LINES@x16xi32>)
  scf.for %tile = %z to %rows step %dim {
    scf.for %row = %z to %dim step %one {
      %arow = arith.addi %tile, %row : index
      scf.for %k = %z to %dim step %one {
        %r3 = arith.muli %row, %three : index
        %k5 = arith.muli %k, %five : index
        %sum = arith.addi %r3, %k5 : index
        %rem = arith.remui %sum, %seven : index
        %value = arith.subi %rem, %three : index
        %v8 = arith.index_cast %value : index to i8
        memref.store %v8, %a[%arow, %k] : memref<@BB_BANK_LINES@x16xi8>
      }
    }
  }
  scf.for %row = %z to %dim step %one {
    scf.for %col = %z to %dim step %one {
      %r2 = arith.muli %row, %two : index
      %c3 = arith.muli %col, %three : index
      %sum = arith.addi %r2, %c3 : index
      %rem = arith.remui %sum, %five : index
      %value = arith.subi %rem, %two : index
      %v8 = arith.index_cast %value : index to i8
      memref.store %v8, %b[%row, %col] : memref<16x16xi8>
    }
  }
  %ab = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %bb = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
  %cb = buckyball.bank_alloc <{row = 1 : i64, col = 4 : i64}>
  %al = buckyball.bank_mvin %a, %ab <{depth = @BB_BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BB_BANK_LINES@x16xi8>
  %bl = buckyball.bank_mvin %b, %bb <{depth = 16 : i64, stride = 1 : i64}> : memref<16x16xi8>
  // Tile t of A (rows 16t..16t+15) times B into rows 16t..16t+15 of C.
  scf.for %base = %z to %rows step %dim {
    %base64 = arith.index_cast %base : index to i64
    %r = buckyball.bank_custom "matmul_i8_tile" (%al, %bl) -> %cb args(%base64, %zero64, %base64 : i64, i64, i64)
  }
  %stored = buckyball.bank_mvout %c, %cb <{depth = @BB_BANK_LINES@ : i64, stride = 1 : i64}> : memref<@BB_BANK_LINES@x16xi32>
  func.call @check_result(%c) : (memref<@BB_BANK_LINES@x16xi32>) -> ()
  buckyball.bank_release %al
  buckyball.bank_release %bl
  buckyball.bank_release %stored
  memref.dealloc %a : memref<@BB_BANK_LINES@x16xi8>
  memref.dealloc %b : memref<16x16xi8>
  memref.dealloc %c : memref<@BB_BANK_LINES@x16xi32>
  return %z8 : i8
}
