func.func private @check_result(memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>) -> ()
func.func @main() -> i8 {
  %zero_i8 = arith.constant 0 : i8
  %zero = arith.constant 0 : index
  %one = arith.constant 1 : index
  %rows = arith.constant @BB_BANK_LINES@ : index
  %windows = arith.constant 64 : index
  %lane = arith.constant 7 : index
  %input = memref.alloc() : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
  %output = memref.alloc() : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
  linalg.fill ins(%zero_i8 : i8) outs(%input : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>)
  scf.for %index = %zero to %rows step %one {
    %value32 = arith.index_cast %index : index to i32
    %value = arith.trunci %value32 : i32 to i8
    memref.store %value, %input[%index, %lane] : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
  }
  scf.for %base = %zero to %rows step %windows {
    %in = memref.subview %input[%base, 0] [64, @BB_BANK_I8_LANES@] [1, 1] : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8> to memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>>
    %out = memref.subview %output[%base, 0] [64, @BB_BANK_I8_LANES@] [1, 1] : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8> to memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>>
    %input_bank = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
    %output_bank = buckyball.bank_alloc <{row = 1 : i64, col = 1 : i64}>
    %loaded = buckyball.bank_mvin %in, %input_bank <{depth = 64 : i64, stride = 1 : i64}> : memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>>
    %result = buckyball.bank_custom "im2col_i8" (%loaded) -> %output_bank {input_side = 8 : i64, kernel = 3 : i64, stride = 1 : i64, padding = 1 : i64, start_row = 0 : i64, start_col = 0 : i64, op1_base = 0 : i64, lane = 7 : i64, window_start = 0 : i64, window_count = 64 : i64}
    %stored = buckyball.bank_mvout %out, %result <{depth = 64 : i64, stride = 1 : i64}> : memref<64x@BB_BANK_I8_LANES@xi8, strided<[@BB_BANK_I8_LANES@, 1], offset: ?>>
    buckyball.bank_release %loaded
    buckyball.bank_release %stored
  }
  func.call @check_result(%output) : (memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>) -> ()
  memref.dealloc %input : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
  memref.dealloc %output : memref<@BB_BANK_LINES@x@BB_BANK_I8_LANES@xi8>
  return %zero_i8 : i8
}
