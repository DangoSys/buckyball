  %late = "device.launch"(%input, %b) <{callee = @producer, hart_class = "@REDUCER_COMPONENT@", operandSegmentSizes = array<i32: 1, 1>}> {device.rank = 0 : i64} : (tensor<8xf32>, tensor<8xf32>) -> tensor<8xf32>
  %first = "device.launch"(%early, %late, %c) <{callee = @join, hart_class = "poly", operandSegmentSizes = array<i32: 2, 1>}> {device.rank = 0 : i64} : (tensor<8xf32>, tensor<8xf32>, tensor<8xf32>) -> tensor<8xf32>
