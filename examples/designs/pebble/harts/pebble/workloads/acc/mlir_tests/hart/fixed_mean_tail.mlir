func.func private @check_result(memref<2x1x1x10xi32>)
func.func @main() -> i8 {
  %zero = arith.constant 0 : i8
  %input = arith.constant dense<[[[[123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456], [2147483647, -2147483648, 0, 1, 0, -1, 9, -10, 11, -12], [2147483647, -2147483648, 0, 1, 0, -1, 12, -13, 14, -15], [2147483647, -2147483648, 0, 1, 0, -1, 15, -16, 17, -18], [123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456]], [[123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456], [2147483647, -2147483648, 0, 1, 0, -1, 19, -20, 21, -22], [2147483647, -2147483648, 0, 1, 0, -1, 22, -23, 24, -25], [2147483647, -2147483648, 3, 4, -3, -4, 25, -26, 27, -28], [123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456]]], [[[123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456], [2147483647, -2147483648, 0, 1, 0, -1, 109, -110, 111, -112], [2147483647, -2147483648, 0, 1, 0, -1, 112, -113, 114, -115], [2147483647, -2147483648, 0, 1, 0, -1, 115, -116, 117, -118], [123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456]], [[123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456], [2147483647, -2147483648, 0, 1, 0, -1, 119, -120, 121, -122], [2147483647, -2147483648, 0, 1, 0, -1, 122, -123, 124, -125], [2147483647, -2147483648, 3, 4, -3, -4, 125, -126, 127, -128], [123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456, 123456]]]]> : tensor<2x2x5x10xi32>
  %crop = tensor.extract_slice %input[0, 0, 1, 0] [2, 2, 3, 10] [1, 1, 1, 1] : tensor<2x2x5x10xi32> to tensor<2x2x3x10xi32>
  %result = "frontend.fixed_mean"(%crop) : (tensor<2x2x3x10xi32>) -> tensor<2x1x1x10xi32>
  %memory = bufferization.to_buffer %result : tensor<2x1x1x10xi32> to memref<2x1x1x10xi32>
  func.call @check_result(%memory) : (memref<2x1x1x10xi32>) -> ()
  return %zero : i8
}
