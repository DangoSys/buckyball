# Product Bazel surface: chip-selected source aliases only.

package(default_visibility = ["//visibility:public"])

package_group(
    name = "product",
    packages = ["//examples/..."],
)

# Infra package group for examples + bazel config.
package_group(
    name = "bazel_clients",
    packages = [
        "//bazel/...",
        "//examples/...",
    ],
)

alias(
    name = "ctests",
    actual = "@bb_chips//:ctests",
)

alias(
    name = "mlir_tests",
    actual = "@bb_chips//:mlir_tests",
)

alias(
    name = "ballISA",
    actual = "@bb_chips//:ballISA",
)

alias(
    name = "bank_params",
    actual = "@bb_chips//:bank_params",
)
